---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ContentDetailLayout from "@/layouts/ContentDetailLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("tools", ({ data }) => !data.draft);
  return entries.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

type Props = { entry: CollectionEntry<"tools"> };
const { entry } = Astro.props;
const { Content } = await render(entry);
const kindLabel = { app: "App", service: "Service", feature: "Feature", workflow: "Workflow" };
---

<ContentDetailLayout
  section="Tools"
  sectionHref="/tools/"
  title={entry.data.title}
  description={entry.data.description}
  pubDatetime={entry.data.pubDatetime}
  modDatetime={entry.data.modDatetime}
  eyebrow={`${kindLabel[entry.data.kind]} · ${entry.data.bestFor}`}
  tags={entry.data.tags}
  officialURL={entry.data.officialURL}
>
  <Content />
</ContentDetailLayout>
