---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import CollectionCard from "@/components/CollectionCard.astro";

const entries = (await getCollection("tools", ({ data }) => !data.draft))
  .sort((a, b) => Number(b.data.favorite) - Number(a.data.favorite) || b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf());

const kindLabel = {
  app: "App",
  service: "Service",
  feature: "Feature",
  workflow: "Workflow",
};
---

<Layout title="Tools | Wynn" description="자주 사용하는 앱과 서비스, 기능의 유용한 사용법을 빠르게 다시 찾습니다.">
  <Header />
  <main id="main-content" class="app-layout">
    <SectionIntro
      eyebrow="Build faster, remember better"
      title="Tools"
      description="앱·서비스·기능을 이용해 무엇을 빠르게 구축할 수 있는지, 다시 사용할 때 필요한 핵심 절차와 팁을 정리합니다."
    />
    <section class="py-10 sm:py-14">
      <div class="border-border bg-surface mb-8 grid gap-5 rounded-2xl border p-6 sm:grid-cols-3 sm:p-8">
        <div>
          <p class="text-accent text-xs font-bold tracking-[0.12em] uppercase">01 · Purpose</p>
          <p class="mt-3 text-sm leading-6">도구가 해결하는 문제와 가장 잘 맞는 작업</p>
        </div>
        <div>
          <p class="text-accent text-xs font-bold tracking-[0.12em] uppercase">02 · Quick start</p>
          <p class="mt-3 text-sm leading-6">처음부터 결과까지 가는 최소 단계</p>
        </div>
        <div>
          <p class="text-accent text-xs font-bold tracking-[0.12em] uppercase">03 · Recall</p>
          <p class="mt-3 text-sm leading-6">다시 사용할 때 놓치기 쉬운 팁과 설정</p>
        </div>
      </div>
      {entries.length > 0 ? (
        <ul class="grid gap-5 sm:grid-cols-2">
          {entries.map(({ id, data }) => (
            <li>
              <CollectionCard
                href={`/tools/${id}/`}
                title={data.title}
                description={data.description}
                eyebrow={kindLabel[data.kind]}
                meta={data.favorite ? "Favorite" : undefined}
                tags={data.tags}
              />
            </li>
          ))}
        </ul>
      ) : (
        <div class="border-border bg-surface rounded-2xl border p-8 sm:p-12">
          <p class="text-accent text-sm font-bold">TOOLKIT</p>
          <h2 class="mt-3 text-2xl font-bold">자주 사용하는 도구를 정리할 공간입니다.</h2>
          <p class="text-muted-foreground mt-3 max-w-xl leading-7">
            빠른 구축 방법, 반복해서 쓰는 기능, 잊기 쉬운 설정을 도구별 문서로 축적합니다.
          </p>
        </div>
      )}
    </section>
  </main>
  <Footer />
</Layout>
