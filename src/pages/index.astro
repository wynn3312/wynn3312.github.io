---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";

const posts = getSortedPosts(await getCollection("posts")).slice(0, 3);
const projects = await getCollection("projects", ({ data }) => !data.draft);
const labs = await getCollection("labs", ({ data }) => !data.draft);
const scraps = await getCollection("scraps", ({ data }) => !data.draft);
const tools = await getCollection("tools", ({ data }) => !data.draft);

const sections = [
  {
    href: "/projects/",
    number: "01",
    title: "Projects",
    description: "완성된 결과보다 맡았던 역할과 구현 기능, 선택의 근거를 중심으로 정리합니다.",
    count: projects.length,
    unit: "projects",
  },
  {
    href: "/lab/",
    number: "02",
    title: "Lab",
    description: "작은 기술 가설을 빠르게 검증하고 설정부터 결과까지 여러 문서로 연결합니다.",
    count: new Set(labs.map(({ data }) => data.experiment)).size,
    unit: "experiments",
  },
  {
    href: "/scraps/",
    number: "03",
    title: "Scraps",
    description: "기사와 기술 이슈의 핵심을 요약하고 그 시점의 질문과 의견을 남깁니다.",
    count: scraps.length,
    unit: "notes",
  },
  {
    href: "/tools/",
    number: "04",
    title: "Tools",
    description: "자주 쓰는 앱과 서비스로 빠르게 구축하는 방법과 다시 떠올릴 핵심 사용법을 정리합니다.",
    count: tools.length,
    unit: "tools",
  },
];
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="grid items-center gap-10 py-16 sm:py-24 lg:grid-cols-[1.35fr_0.65fr] lg:py-32">
      <div>
        <p class="text-accent mb-5 text-sm font-bold tracking-[0.16em] uppercase">
          Game & AI Developer
        </p>
        <h1 class="max-w-3xl text-5xl leading-[1.04] font-bold tracking-[-0.055em] sm:text-7xl">
          만들고, 검증하고,<br />
          <span class="text-muted-foreground">과정을 기록합니다.</span>
        </h1>
        <p class="text-muted-foreground mt-7 max-w-2xl text-base leading-8 sm:text-lg">
          게임 개발 경험을 바탕으로 AI·추천 시스템·에이전트 기반 서비스를 만드는 김경수입니다.
          결과뿐 아니라 문제를 정의하고 해결해 나간 맥락을 남깁니다.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/projects/" class="bg-accent text-accent-foreground rounded-full px-5 py-3 text-sm font-bold transition-transform hover:-translate-y-0.5">
            프로젝트 보기 →
          </a>
          <a href="https://github.com/wynn3312" target="_blank" rel="noreferrer" class="border-border bg-surface hover:border-accent/50 rounded-full border px-5 py-3 text-sm font-bold transition-colors">
            GitHub
          </a>
          <Socials />
        </div>
      </div>
      <aside class="border-border bg-surface relative overflow-hidden rounded-3xl border p-7 sm:p-9">
        <div class="bg-accent/10 absolute -top-16 -right-16 size-40 rounded-full blur-2xl"></div>
        <p class="text-muted-foreground text-xs font-bold tracking-[0.14em] uppercase">Currently exploring</p>
        <ul class="relative mt-8 space-y-5">
          <li class="border-border border-b pb-5">
            <span class="text-sm font-bold">LLM & Agents</span>
            <p class="text-muted-foreground mt-1 text-sm">도구 사용과 지식 구조화</p>
          </li>
          <li class="border-border border-b pb-5">
            <span class="text-sm font-bold">Recommendation</span>
            <p class="text-muted-foreground mt-1 text-sm">데이터 전처리와 개인화</p>
          </li>
          <li>
            <span class="text-sm font-bold">Interactive Systems</span>
            <p class="text-muted-foreground mt-1 text-sm">게임과 사용자 경험</p>
          </li>
        </ul>
      </aside>
    </section>

    <section class="border-border/80 border-t py-14 sm:py-20">
      <div class="mb-8 flex items-end justify-between gap-5">
        <div>
          <p class="text-accent text-sm font-bold tracking-[0.14em] uppercase">Explore</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">기록의 네 가지 층위</h2>
        </div>
        <p class="text-muted-foreground hidden max-w-sm text-right text-sm leading-6 md:block">
          규모와 목적에 따라 기록을 나누어 필요한 맥락을 빠르게 찾을 수 있습니다.
        </p>
      </div>
      <div class="grid gap-5 lg:grid-cols-2 xl:grid-cols-4">
        {sections.map(section => (
          <a href={section.href} class="group border-border bg-surface hover:border-accent/50 flex min-h-72 flex-col rounded-2xl border p-7 transition duration-200 hover:-translate-y-1 hover:shadow-xl">
            <div class="text-muted-foreground flex items-center justify-between text-xs font-bold tracking-[0.12em] uppercase">
              <span>{section.number}</span>
              <span>{section.count} {section.unit}</span>
            </div>
            <h3 class="group-hover:text-accent mt-12 text-3xl font-bold tracking-tight transition-colors">{section.title}</h3>
            <p class="text-muted-foreground mt-4 grow text-sm leading-7">{section.description}</p>
            <span class="text-accent mt-7 text-sm font-bold">둘러보기 →</span>
          </a>
        ))}
      </div>
    </section>

    {posts.length > 0 && (
      <section class="border-border/80 border-t py-14 sm:py-20">
        <div class="mb-8">
          <p class="text-accent text-sm font-bold tracking-[0.14em] uppercase">Latest notes</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">최근 작성한 기록</h2>
        </div>
        <ul class="divide-border border-border bg-surface divide-y rounded-2xl border px-6 sm:px-8">
          {posts.map(({ id, data }) => (
            <li>
              <a href={`/posts/${id}/`} class="group grid gap-2 py-6 sm:grid-cols-[1fr_auto] sm:items-center">
                <div>
                  <h3 class="group-hover:text-accent text-lg font-bold transition-colors">{data.title}</h3>
                  <p class="text-muted-foreground mt-2 text-sm leading-6">{data.description}</p>
                </div>
                <span class="text-accent text-sm font-bold">읽기 →</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
  <Footer />
</Layout>
