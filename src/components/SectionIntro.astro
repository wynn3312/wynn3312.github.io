---
type Props = {
  eyebrow: string;
  title: string;
  description: string;
};

const { eyebrow, title, description } = Astro.props;
---

<section class="border-border/80 border-b py-14 sm:py-20">
  <p class="text-accent mb-4 text-sm font-bold tracking-[0.16em] uppercase">{eyebrow}</p>
  <h1 class="max-w-3xl text-4xl leading-tight font-bold tracking-[-0.04em] sm:text-6xl">{title}</h1>
  <p class="text-muted-foreground mt-5 max-w-2xl text-base leading-7 sm:text-lg">{description}</p>
</section>
